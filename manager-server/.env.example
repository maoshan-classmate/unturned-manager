# unturned-manager 后端环境变量
# 复制此文件为 .env 并填入实际值

# 必填
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
ADMIN_PASSWORD=change-me

# 可选（以下为默认值）
SERVER_PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
DB_PATH=./data/unturned-manager.db
DATA_DIR=./data
CORS_ORIGIN=http://localhost:5173
# U3DS 安装根目录（ADR-0003 / T2 全局化）
# 生产 Linux：/opt/unturned
# 开发 Windows：C:/path/to/U3DS 或 D:/unturned-manager/test-servers
INSTALL_DIR=/opt/unturned
