# ─── 依赖 ───
node_modules/
.pnpm-store/

# ─── 包管理器 ───
# 本项目统一使用 npm，只保留 package-lock.json
pnpm-lock.yaml
yarn.lock

# ─── 环境变量与密钥 ───
# 只有 .env.example 模板入库，真实配置永不提交
.env
.env.local
.env.production
.env.*.local

# ─── 构建产物 ───
dist/
build/
.vite/
*.tsbuildinfo

# ─── 数据库 ───
data/
*.db
*.db-shm
*.db-wal

# ─── 运行时数据目录 ───
# Docker 宿主挂载点、服务端实例数据、自动备份
/opt/
/steamcmd/
/Servers/
test-servers/
backups/
manager-server/backups/

# ─── 配置备份 ───
# 面板写配置前自动生成的时间戳副本
*.bak.*

# ─── 测试产物 ───
coverage/
.playwright-mcp/
.test-install/
manager-server/.test-install/
manager-server/test-results/
manager-web/test-results/
manager-server/playwright-report/
manager-web/playwright-report/

# ─── 日志 ───
*.log

# ─── 编辑器 ───
.idea/
.vscode/
*.swp
*.swo

# ─── 操作系统 ───
.DS_Store
Thumbs.db
*.stackdump

# ─── 只读第三方参考仓 ───
.research/

# ─── 开发工具本地数据 ───
# 会话记忆与本地权限配置属于个人开发环境，不随仓库分发
.serena/
memory/
.claude/settings.local.json

# ─── 一次性调研产出 ───
# reference_*.md 是活参考文档，保留入库
claudedocs/research_*.md
claudedocs/workflow_*.md
claudedocs/archive/

# ─── 用户本地输入 ───
*BUG汇总*.txt
